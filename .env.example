# Servidor
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# JWT (obrigatório em produção — use string longa e aleatória)
JWT_SECRET=altere-esta-chave-secreta-muito-longa-em-producao

# Admin inicial (seed no boot se não existir)
ADMIN_EMAIL=admin@relogiodouble.com
ADMIN_PASSWORD=AltereEstaSenha123!

# Mercado Pago (PIX). Sem token: checkout em modo stub; admin ainda concede dias manualmente.
MERCADOPAGO_ACCESS_TOKEN=
# Webhook: configure no painel MP apontando para {BASE_URL}/api/webhooks/mercadopago

# SQLite
DATABASE_PATH=./data/cerebro.db

# Coletor Blaze (intervalo em ms)
COLLECTOR_INTERVAL_MS=5000

# --- Fallback / geo-block (Render Oregon costuma receber HTTP 451 / code 1016) ---
# Espelho(s) de histórico — lista separada por vírgula OK
FALLBACK_HISTORY_URL=
# Proxy HTTP(S) com saída no Brasil (undici ProxyAgent). Também aceita HTTPS_PROXY.
BLAZE_HTTP_PROXY=
# HTTPS_PROXY=

# Relé BR → POST /api/ingest/rounds (scripts/br-relay.mjs)
# Defina a mesma chave no servidor e na máquina brasileira.
INGEST_SECRET=
# No relé (máquina BR):
# TARGET_URL=https://seu-app.onrender.com
# INGEST_SECRET=...
# INTERVAL_MS=5000
