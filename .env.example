# Servidor
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# JWT (obrigatório em produção — use string longa e aleatória)
JWT_SECRET=altere-esta-chave-secreta-muito-longa-em-producao

# Admin inicial (seed no boot se não existir)
ADMIN_EMAIL=admin@relogiodouble.com
ADMIN_PASSWORD=AltereEstaSenha123!

# Mercado Pago (PIX). Sem token: checkout em modo stub; admin ainda concede dias manualmente.
MERCADOPAGO_ACCESS_TOKEN=
# Webhook: configure no painel MP apontando para {BASE_URL}/api/webhooks/mercadopago

# SQLite
DATABASE_PATH=./data/cerebro.db

# Coletor Blaze (intervalo em ms)
COLLECTOR_INTERVAL_MS=5000
